{
  "name": "station-device-draw",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:viewer && bun scripts/dev.ts",
    "dev:local": "bun run build:viewer && vite --host 0.0.0.0",
    "dev:server": "bun --watch server/index.ts",
    "build": "bun run build:viewer && tsc --noEmit && vite build && bun run build:server",
    "build:server": "tsc -p tsconfig.server.json && bun build server/index.ts --target=bun --outdir dist-server",
    "build:viewer": "vite build --config vite.viewer.config.ts && tsc -p tsconfig.viewer.json && bun scripts/package-viewer.ts",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "bash scripts/deploy.sh",
    "test": "bun test tests/*.test.ts",
    "test:server": "bun test ./tests/server/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:chrome": "playwright test --project=chrome",
    "test:e2e:edge": "playwright test --project=edge",
    "test:e2e:webkit": "playwright test --project=safari-webkit",
    "test:e2e:server": "playwright test --config playwright.server.config.ts",
    "test:safari": "bun run build && bun scripts/check-safari.ts",
    "test:safari:server": "bun run build && bun scripts/check-server-safari.ts",
    "test:benchmark": "playwright test --config playwright.performance.config.ts",
    "check:package": "bun scripts/check-package.ts",
    "test:deploy": "bun scripts/check-deploy.ts",
    "check": "bun run test && bun run test:server && bun run test:deploy && bun run build && bun run check:package",
    "deploy:rollback": "bash scripts/deploy.sh rollback",
    "deploy:status": "bash scripts/deploy.sh status",
    "deploy:backup": "bash scripts/deploy.sh backup",
    "backup": "bun scripts/backup.ts"
  },
  "dependencies": {
    "@antv/x6": "^3.1.8",
    "lucide": "^0.468.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/bun": "1.3.14",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "packageManager": "bun@1.3.14"
}
