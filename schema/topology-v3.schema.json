{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:topology-kit:document:v3",
  "title": "Topology Document v3",
  "type": "object",
  "properties": {
    "format": {
      "const": "topology-document"
    },
    "version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "name": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "category": {
      "type": "string",
      "maxLength": 60,
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      },
      "maxItems": 64,
      "minItems": 1
    },
    "topology": {
      "$ref": "#/$defs/topology"
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "name",
    "description",
    "category",
    "createdAt",
    "updatedAt",
    "templates",
    "topology"
  ],
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        "label": {
          "type": "string",
          "maxLength": 40,
          "minLength": 1
        },
        "kind": {
          "enum": [
            "rf",
            "if",
            "ethernet",
            "logical"
          ]
        },
        "side": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom"
          ]
        },
        "offset": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "side"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        "label": {
          "type": "string",
          "maxLength": 40,
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "maxLength": 20
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "required": [
        "key",
        "label",
        "unit",
        "decimals"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        "fields": {
          "type": "object",
          "maxProperties": 20,
          "additionalProperties": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1
          }
        },
        "statusField": {
          "type": "string",
          "maxLength": 150,
          "minLength": 1
        },
        "statusMap": {
          "type": "object",
          "maxProperties": 30,
          "additionalProperties": {
            "enum": [
              "normal",
              "warning",
              "offline"
            ]
          }
        }
      },
      "required": [
        "source",
        "fields"
      ],
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        "version": {
          "const": 1
        },
        "label": {
          "type": "string",
          "maxLength": 40,
          "minLength": 1
        },
        "en": {
          "type": "string",
          "maxLength": 40
        },
        "icon": {
          "type": "string",
          "maxLength": 50,
          "minLength": 1,
          "enum": [
            "Activity",
            "SatelliteDish",
            "Cpu",
            "Server",
            "Router",
            "Network",
            "Zap",
            "LayoutDashboard",
            "Cable",
            "ChevronDown",
            "ArrowUpRight",
            "Search",
            "Bell",
            "Settings",
            "HelpCircle",
            "Plus",
            "Minus",
            "Maximize",
            "Scan",
            "MousePointer2",
            "Hand",
            "Undo2",
            "Redo2",
            "Save",
            "Download",
            "Upload",
            "Trash2",
            "X",
            "Check",
            "RefreshCw",
            "Pause",
            "Play",
            "LockKeyhole",
            "PencilRuler",
            "CircleAlert",
            "ChevronRight",
            "CircleCheck",
            "Clock3",
            "Unplug",
            "Info",
            "Layers",
            "SlidersHorizontal",
            "RotateCcw",
            "Radio",
            "Move",
            "ExternalLink"
          ]
        },
        "model": {
          "type": "string",
          "maxLength": 100
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          },
          "maxItems": 20
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          },
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "version",
        "label",
        "en",
        "icon",
        "model",
        "metrics",
        "ports"
      ],
      "additionalProperties": false
    },
    "nodeData": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        "title": {
          "type": "string",
          "maxLength": 60,
          "minLength": 1
        },
        "deviceId": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "address": {
          "type": "string",
          "maxLength": 100
        },
        "visibleMetrics": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "normal",
            "warning",
            "offline"
          ]
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          },
          "maxItems": 128
        },
        "portSpacing": {
          "type": "integer",
          "minimum": 18,
          "maximum": 48
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "locked": {
          "type": "boolean",
          "description": "Lock node position in the editor; omitted means unlocked."
        }
      },
      "required": [
        "kind",
        "title",
        "deviceId",
        "address",
        "visibleMetrics",
        "status"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "data": {
          "$ref": "#/$defs/nodeData"
        }
      },
      "required": [
        "id",
        "x",
        "y",
        "data"
      ],
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "cell": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        "port": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        }
      },
      "required": [
        "cell",
        "port"
      ],
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "properties": {
        "style": {
          "enum": [
            "solid",
            "dashed",
            "double",
            "jacket",
            "braided"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 14
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "arrows": {
          "type": "boolean"
        }
      },
      "required": [
        "style",
        "width",
        "color",
        "arrows"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[\\w.-]+$",
          "not": {
            "enum": [
              "__proto__",
              "prototype",
              "constructor"
            ]
          }
        },
        "source": {
          "$ref": "#/$defs/endpoint"
        },
        "target": {
          "$ref": "#/$defs/endpoint"
        },
        "kind": {
          "enum": [
            "rf",
            "if",
            "ethernet",
            "logical"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "maxItems": 200
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "label",
        "vertices"
      ],
      "additionalProperties": false
    },
    "topology": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "maxItems": 300
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 1000
        },
        "elements": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/diagramElement"
          }
        },
        "order": {
          "type": "array",
          "maxItems": 400,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "diagramElement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            },
            "kind": {
              "const": "group"
            },
            "x": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "width": {
              "type": "number",
              "minimum": 160,
              "maximum": 10000
            },
            "height": {
              "type": "number",
              "minimum": 80,
              "maximum": 10000
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "locked": {
              "type": "boolean"
            },
            "members": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 300,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "kind",
            "x",
            "y",
            "width",
            "height",
            "title",
            "color",
            "members"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            },
            "kind": {
              "const": "note"
            },
            "x": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "width": {
              "type": "number",
              "minimum": 160,
              "maximum": 10000
            },
            "height": {
              "type": "number",
              "minimum": 80,
              "maximum": 10000
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "locked": {
              "type": "boolean"
            },
            "text": {
              "type": "string",
              "maxLength": 2000
            },
            "fontSize": {
              "type": "integer",
              "minimum": 12,
              "maximum": 28
            }
          },
          "required": [
            "id",
            "kind",
            "x",
            "y",
            "width",
            "height",
            "title",
            "color",
            "text",
            "fontSize"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[\\w.-]+$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            },
            "kind": {
              "const": "legend"
            },
            "x": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "width": {
              "type": "number",
              "minimum": 160,
              "maximum": 10000
            },
            "height": {
              "type": "number",
              "minimum": 80,
              "maximum": 10000
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "locked": {
              "type": "boolean"
            },
            "showStatus": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "kind",
            "x",
            "y",
            "width",
            "height",
            "title",
            "color",
            "showStatus"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
